# Local build Dockerfile - uses parent directory as build context
# so the path dependency on ../alkemio-virtual-contributor-engine resolves.
# Used by quickstart-services-ai.yml for local development.

# =============================================================================
# Stage 1: Build stage - Python 3.12 (required by pyproject.toml)
# =============================================================================
FROM python:3.12-slim-bookworm AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m venv /opt/poetry && \
    /opt/poetry/bin/pip install --no-cache-dir poetry && \
    ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VIRTUALENVS_CREATE=true \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# Copy the shared library so the path dependency resolves
COPY alkemio-virtual-contributor-engine/ /alkemio-virtual-contributor-engine/

# Copy dependency files from the project subdirectory
COPY virtual-contributor-guidance-engine/pyproject.toml virtual-contributor-guidance-engine/poetry.lock* ./

RUN poetry install --only main --no-root --no-ansi && \
    rm -rf $POETRY_CACHE_DIR

# Copy application code from the project subdirectory
COPY virtual-contributor-guidance-engine/ /app/

RUN touch /app/app.log

# =============================================================================
# Stage 2: Runtime stage
# =============================================================================
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

COPY --from=builder /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 1000 appuser
USER appuser

ENTRYPOINT ["/app/.venv/bin/python", "main.py"]
